@page "/fibonacci"
@rendermode InteractiveServer
<h3>Fibonacci</h3>

<div class="calc-box">
    <input type="number"
           @bind-value="Count"
           @bind-value:event="oninput"
           min="0"
           placeholder="Enter count" />
</div>

@if (sequence.Count > 0)
{
    <p class="result">@string.Join(", ", sequence)</p>
}
